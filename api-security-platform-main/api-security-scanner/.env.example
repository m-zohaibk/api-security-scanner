# Flask Web Dashboard Settings
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection
DATABASE_URL=sqlite:///database/scanner.db

# Scanner Engine Thresholds
MAX_ENDPOINTS=50
SCAN_TIMEOUT=30

# Logging Output Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
